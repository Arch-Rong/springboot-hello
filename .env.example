# 选择运行环境：本地用 dev，服务器用 prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# 仅当 SPRING_PROFILES_ACTIVE=prod 时需要填写
# Docker：docker compose up -d（宿主机端口 5433，避开本机其他 Postgres）
DB_URL=jdbc:postgresql://127.0.0.1:5433/springboot_hello
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=app_user
DB_PASSWORD=hello_local_only

# 本示例默认 update；正式接入迁移后建议改为 validate
JPA_DDL_AUTO=update
