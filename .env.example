# Select the environment. Use dev locally and prod on the server.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Required when SPRING_PROFILES_ACTIVE=prod.
# Replace these values with the database actually used by the server.
DB_URL=jdbc:postgresql://127.0.0.1:5432/springboot_hello
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=app_user
DB_PASSWORD=change-me

# The default is update for this sample. Prefer validate after adding migrations.
JPA_DDL_AUTO=update
